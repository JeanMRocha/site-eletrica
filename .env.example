# Application
HTTP_ADDR=:8080

# Auth demo
AUTH_DEMO_EMAIL=operator@example.com
AUTH_DEMO_NAME=Operator
AUTH_DEMO_PASSWORD=change-me-now

# SSH control channel defaults for the first node
SSH_CONTROL_MODE=ssh
SSH_HOST=change-me.example.com
SSH_PORT=22
SSH_USER=deploy
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts
